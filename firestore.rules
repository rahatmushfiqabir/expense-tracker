rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only access their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /expenses/{expenseId} {
      // Allow creating expenses if logged in
      allow create: if request.auth != null;
      // Allow reading, updating, deleting only own expenses
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /budgets/{budgetId} {
      // Allow creating budgets if logged in
      allow create: if request.auth != null;
      // Allow reading, updating, deleting only own budgets
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /categoryBudgets/{budgetId} {
      // Allow creating category budgets if logged in
      allow create: if request.auth != null;
      // Allow reading, updating, deleting only own category budgets
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
